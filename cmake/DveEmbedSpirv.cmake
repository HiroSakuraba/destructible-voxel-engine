# Script mode (cmake -P): embeds SPIR-V files into one C++ source.
#   -DDVE_EMBED_OUTPUT=<file.cpp> -DDVE_EMBED_NAMESPACE=<ns> -DDVE_EMBED_INPUTS=<a.spv;b.spv>
# Each input becomes `std::span<const std::byte> <stem>() noexcept` in the namespace, plus
# `bool available() noexcept { return true; }`. Words stay little-endian as dxc wrote them.
if(NOT DVE_EMBED_OUTPUT OR NOT DVE_EMBED_NAMESPACE)
    message(FATAL_ERROR "DveEmbedSpirv.cmake needs DVE_EMBED_OUTPUT and DVE_EMBED_NAMESPACE")
endif()
string(REPLACE "|" ";" _inputs "${DVE_EMBED_INPUTS}")
set(_body "// Generated by cmake/DveEmbedSpirv.cmake. Do not edit.\n#include <cstddef>\n#include <span>\n\nnamespace ${DVE_EMBED_NAMESPACE} {\nnamespace {\n")
set(_accessors "")
foreach(_input IN LISTS _inputs)
    get_filename_component(_stem "${_input}" NAME_WE)
    file(READ "${_input}" _hex HEX)
    string(LENGTH "${_hex}" _length)
    if(_length EQUAL 0)
        message(FATAL_ERROR "empty SPIR-V file ${_input}")
    endif()
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(REGEX REPLACE "(0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],)" "\\1\n" _bytes "${_bytes}")
    string(APPEND _body "alignas(4) const unsigned char k_${_stem}[] = {\n${_bytes}};\n")
    string(APPEND _accessors "std::span<const std::byte> ${_stem}() noexcept { return std::as_bytes(std::span(k_${_stem})); }\n")
endforeach()
string(APPEND _body "} // namespace\n\nbool available() noexcept { return true; }\n${_accessors}} // namespace ${DVE_EMBED_NAMESPACE}\n")
file(WRITE "${DVE_EMBED_OUTPUT}.tmp" "${_body}")
file(COPY_FILE "${DVE_EMBED_OUTPUT}.tmp" "${DVE_EMBED_OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${DVE_EMBED_OUTPUT}.tmp")
