# dve CMake package (generated by cmake/DveInstall.cmake).
#
#   find_package(dve 2.35 REQUIRED)            # SameMinorVersion: any 2.35.x
#   find_package(dve 2.35 REQUIRED COMPONENTS player_runtime platform_sdl3)
#   target_link_libraries(game PRIVATE dve::player_runtime)
#
# Imported targets: dve::core, dve::platform, dve::rhi, dve::render_bridge, dve::audio_synth,
# dve::player_runtime and, when DVE was built with SDL3, dve::platform_sdl3 / dve::audio_sdl3.
# The build's feature definitions (DVE_HAVE_LUA, DVE_HAVE_JOLT, DVE_GEOMETRY_MODE_*, ...) come
# with dve::core; include <dve/build_config.hpp> to have the compiler verify them.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(dve_VERSION_GIT_DESCRIBE "@DVE_VERSION_GIT_DESCRIBE@")
set(dve_HAVE_LUA @DVE_CONFIG_HAVE_LUA@)
set(dve_HAVE_JOLT @DVE_CONFIG_HAVE_JOLT@)
set(dve_GEOMETRY_MODE "@DVE_GEOMETRY_MODE_NORMALIZED@")
set(dve_SDL3_BUNDLED @DVE_CONFIG_SDL3_BUNDLED@)
set(dve_BUILD_CONFIG_DEFINES "@DVE_BUILD_CONFIG_DEFINE_STRING@")
set(dve_LIBRARIES "@DVE_CONFIG_EXPORTED_LIBRARIES@")
set(dve_CXX_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@")
set(dve_CXX_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@")

# Packages whose imported targets the dve targets link (recorded at build time).
@DVE_CONFIG_FIND_DEPENDENCIES@
# Imported helper targets the build created itself (Lua via pkg-config or the ABI fallback,
# RtMidi without a CMake package, legacy Jolt/Box include+library pairs). They are recreated
# under the same names from the library files recorded at build time; a file that is missing
# on this machine is looked up by name with find_library().
function(_dve_resolve_library_file path out)
    if(NOT path OR EXISTS "${path}")
        set(${out} "${path}" PARENT_SCOPE)
        return()
    endif()
    get_filename_component(_name "${path}" NAME)
    string(MAKE_C_IDENTIFIER "${_name}" _id)
    find_library(dve_DEPENDENCY_${_id} NAMES "${_name}")
    if(NOT dve_DEPENDENCY_${_id})
        set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE PARENT_SCOPE)
        set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
            "dve needs ${_name} (built against ${path}); install it or set dve_DEPENDENCY_${_id}" PARENT_SCOPE)
        set(${out} "" PARENT_SCOPE)
        return()
    endif()
    set(${out} "${dve_DEPENDENCY_${_id}}" PARENT_SCOPE)
endfunction()

macro(_dve_recreate_imported name kind location links)
    if(NOT TARGET "${name}")
        add_library("${name}" ${kind} IMPORTED)
        if(NOT "${location}" STREQUAL "")
            _dve_resolve_library_file("${location}" _dve_location)
            set_target_properties("${name}" PROPERTIES IMPORTED_LOCATION "${_dve_location}")
        endif()
        set(_dve_links "")
        foreach(_dve_link IN ITEMS ${links})
            if(_dve_link MATCHES "^/")
                _dve_resolve_library_file("${_dve_link}" _dve_link)
            endif()
            list(APPEND _dve_links "${_dve_link}")
        endforeach()
        if(_dve_links)
            set_target_properties("${name}" PROPERTIES INTERFACE_LINK_LIBRARIES "${_dve_links}")
        endif()
    endif()
endmacro()
@DVE_CONFIG_RECREATED_TARGETS@
if(NOT DEFINED ${CMAKE_FIND_PACKAGE_NAME}_FOUND OR ${CMAKE_FIND_PACKAGE_NAME}_FOUND)
    include("${CMAKE_CURRENT_LIST_DIR}/dveTargets.cmake")
    foreach(_dve_component IN LISTS ${CMAKE_FIND_PACKAGE_NAME}_FIND_COMPONENTS)
        if(TARGET dve::${_dve_component})
            set(${CMAKE_FIND_PACKAGE_NAME}_${_dve_component}_FOUND TRUE)
        else()
            set(${CMAKE_FIND_PACKAGE_NAME}_${_dve_component}_FOUND FALSE)
        endif()
    endforeach()
    check_required_components(${CMAKE_FIND_PACKAGE_NAME})
endif()
