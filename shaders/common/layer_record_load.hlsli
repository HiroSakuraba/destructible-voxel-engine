#ifndef DVE_LAYER_RECORD_LOAD_HLSLI
#define DVE_LAYER_RECORD_LOAD_HLSLI
// Scalar ABI loaders: offsets match the separately validated stable records.
MaterialRecord LoadLayerMaterialRecord(uint o) { MaterialRecord r;
    r.baseColorR = asfloat(gLayerData[o+0]);
    r.baseColorG = asfloat(gLayerData[o+1]);
    r.baseColorB = asfloat(gLayerData[o+2]);
    r.baseColorA = asfloat(gLayerData[o+3]);
    r.emissiveR = asfloat(gLayerData[o+4]);
    r.emissiveG = asfloat(gLayerData[o+5]);
    r.emissiveB = asfloat(gLayerData[o+6]);
    r.metallic = asfloat(gLayerData[o+7]);
    r.roughness = asfloat(gLayerData[o+8]);
    r.specular = asfloat(gLayerData[o+9]);
    r.shadingModel = gLayerData[o+10];
    r.blendMode = gLayerData[o+11];
    r.subsurfaceScatterDistanceMeters = asfloat(gLayerData[o+12]);
    r.subsurfaceColorR = asfloat(gLayerData[o+13]);
    r.subsurfaceColorG = asfloat(gLayerData[o+14]);
    r.subsurfaceColorB = asfloat(gLayerData[o+15]);
    r.clearCoat = asfloat(gLayerData[o+16]);
    r.clearCoatRoughness = asfloat(gLayerData[o+17]);
    r.foliageColorR = asfloat(gLayerData[o+18]);
    r.foliageColorG = asfloat(gLayerData[o+19]);
    r.foliageColorB = asfloat(gLayerData[o+20]);
    r.foliageTransmittance = asfloat(gLayerData[o+21]);
    r.foliageWrap = asfloat(gLayerData[o+22]);
    r.transmission = asfloat(gLayerData[o+23]);
    r.indexOfRefraction = asfloat(gLayerData[o+24]);
    r.attenuationColorR = asfloat(gLayerData[o+25]);
    r.attenuationColorG = asfloat(gLayerData[o+26]);
    r.attenuationColorB = asfloat(gLayerData[o+27]);
    r.attenuationDistanceMeters = asfloat(gLayerData[o+28]);
    return r;
}
PolygonMaterialMappingRecord LoadLayerPolygonMaterialMappingRecord(uint o) { PolygonMaterialMappingRecord r;
    r.mappingMode = gLayerData[o+0];
    r.heightMode = gLayerData[o+1];
    r.baseColorTexture = gLayerData[o+2];
    r.metallicRoughnessTexture = gLayerData[o+3];
    r.normalTexture = gLayerData[o+4];
    r.emissiveTexture = gLayerData[o+5];
    r.opacityTexture = gLayerData[o+6];
    r.heightTexture = gLayerData[o+7];
    r.detailBaseColorTexture = gLayerData[o+8];
    r.detailNormalTexture = gLayerData[o+9];
    r.detailRoughnessTexture = gLayerData[o+10];
    r.baseTexcoord = gLayerData[o+11];
    r.normalTexcoord = gLayerData[o+12];
    r.heightTexcoord = gLayerData[o+13];
    r.detailTexcoord = gLayerData[o+14];
    r.mappingFlags = gLayerData[o+15];
    r.baseScaleX = asfloat(gLayerData[o+16]);
    r.baseScaleY = asfloat(gLayerData[o+17]);
    r.baseOffsetX = asfloat(gLayerData[o+18]);
    r.baseOffsetY = asfloat(gLayerData[o+19]);
    r.baseRotationRadians = asfloat(gLayerData[o+20]);
    r.triplanarScale = asfloat(gLayerData[o+21]);
    r.triplanarBlendSharpness = asfloat(gLayerData[o+22]);
    r.detailScaleX = asfloat(gLayerData[o+23]);
    r.detailScaleY = asfloat(gLayerData[o+24]);
    r.detailOffsetX = asfloat(gLayerData[o+25]);
    r.detailOffsetY = asfloat(gLayerData[o+26]);
    r.detailRotationRadians = asfloat(gLayerData[o+27]);
    r.detailColorStrength = asfloat(gLayerData[o+28]);
    r.detailNormalStrength = asfloat(gLayerData[o+29]);
    r.detailRoughnessStrength = asfloat(gLayerData[o+30]);
    r.detailFadeStartMeters = asfloat(gLayerData[o+31]);
    r.detailFadeEndMeters = asfloat(gLayerData[o+32]);
    r.heightScale = asfloat(gLayerData[o+33]);
    r.heightReferencePlane = asfloat(gLayerData[o+34]);
    r.maximumParallaxDistanceMeters = asfloat(gLayerData[o+35]);
    r.minimumHeightSteps = gLayerData[o+36];
    r.maximumHeightSteps = gLayerData[o+37];
    r.refinementSteps = gLayerData[o+38];
    r.normalScale = asfloat(gLayerData[o+39]);
    r.detailNormalScale = asfloat(gLayerData[o+40]);
    r.alphaCutoff = asfloat(gLayerData[o+41]);
    r.additionalTexcoords = gLayerData[o+42];
    r.reserved2 = gLayerData[o+43];
    return r;
}
SurfaceDetailRecord LoadLayerSurfaceDetailRecord(uint o) { SurfaceDetailRecord r;
    r.pattern = gLayerData[o+0];
    r.space = gLayerData[o+1];
    r.seed = gLayerData[o+2];
    r.periodMeters = asfloat(gLayerData[o+3]);
    r.rotationX = asfloat(gLayerData[o+4]);
    r.rotationY = asfloat(gLayerData[o+5]);
    r.rotationZ = asfloat(gLayerData[o+6]);
    r.rotationW = asfloat(gLayerData[o+7]);
    r.grainStretch = asfloat(gLayerData[o+8]);
    r.colorVariation = asfloat(gLayerData[o+9]);
    r.roughnessVariation = asfloat(gLayerData[o+10]);
    r.bumpHeightMeters = asfloat(gLayerData[o+11]);
    r.uvTileMeters = asfloat(gLayerData[o+12]);
    r.reserved0 = gLayerData[o+13];
    r.reserved1 = gLayerData[o+14];
    r.reserved2 = gLayerData[o+15];
    return r;
}
#endif
