// Experimental diffuse gather for one compact level-zero probe per query.
// Directions are the 32 equal-area level-zero directions generated by
// split_rc_directions_cs. `radiance` contains merged RGB + availability alpha.
// Output is cosine-weighted diffuse radiance, alpha 1 if at least one valid
// above-surface sample contributed; otherwise alpha 0. Missing directions are
// renormalized over available directions, which is biased under sparse coverage.
struct Query { uint4 probe; float4 normal; };
[[vk::binding(0,0)]] StructuredBuffer<uint> keys : register(t0);
[[vk::binding(1,0)]] StructuredBuffer<uint> offsets : register(t1);
[[vk::binding(2,0)]] StructuredBuffer<float4> radiance : register(t2);
[[vk::binding(3,0)]] StructuredBuffer<float4> directions : register(t3);
[[vk::binding(4,0)]] StructuredBuffer<Query> queries : register(t4);
[[vk::binding(5,0)]] RWStructuredBuffer<float4> output : register(u0);
[numthreads(64,1,1)]
void main(uint3 id:SV_DispatchThreadID){
    uint count,stride;queries.GetDimensions(count,stride);uint outputCount;output.GetDimensions(outputCount,stride);
    if(id.x>=count||id.x>=outputCount)return;
    output[id.x]=float4(0,0,0,0);
    uint keyCount,offsetCount,lightCount,dirCount;
    keys.GetDimensions(keyCount,stride);offsets.GetDimensions(offsetCount,stride);
    radiance.GetDimensions(lightCount,stride);directions.GetDimensions(dirCount,stride);
    const Query q=queries[id.x];const uint slot=q.probe.x;
    if(slot>=keyCount||slot>=offsetCount||dirCount<32u)return;
    const uint k=keys[slot];if(k==0u)return;
    const uint packed=k-1u,level=(packed>>24)&3u,sheet=(packed>>26)&7u;
    if((packed>>29)!=0u||level!=0u||sheet>=6u)return;
    const uint offset=offsets[slot];if(offset==0xffffffffu||offset>=lightCount||lightCount-offset<32u)return;
    if(!all(isfinite(q.normal.xyz))||dot(q.normal.xyz,q.normal.xyz)<1e-12F)return;
    const float3 n=normalize(q.normal.xyz);float3 sum=0;float total=0;
    [loop]for(uint i=0;i<32u;++i){
        const float4 direction=directions[i],light=radiance[offset+i];
        if(direction.w<0.5F || !all(isfinite(direction)) || !all(isfinite(light)) || light.w<0.5F || any(light.xyz<0))continue;
        const float weight=max(0.0F,dot(n,direction.xyz));
        sum+=weight*light.xyz;total+=weight;
    }
    if(total>1e-6F)output[id.x]=float4(sum/total,1);
}
