DVE_GAME 1
# GI showcase: a Cornell-box style room for comparing ambient occlusion and indirect light.
name=GI Showcase
version=0.1.0
entryScene=scenes/main.dvoxscene.json
startupScript=scripts/main.lua
settings=game_settings.txt
camera=0,1.5,6.2 -> 0,1.45,0
bind.sun_left=key:q
bind.sun_right=key:e
bind.sun_up=key:x
bind.sun_down=key:z
bind.sun_reset=key:r
bind.ao_view=key:t
