DVE_GAME 1
# Sample game used by the dve_player tests (loose folder and packed .dvepak).
name=Player Sample
version=0.1.0
entryScene=scenes/main.dvoxscene.json
startupScript=scripts/main.lua
settings=game_settings.txt
camera=3.3,2.6,5.2 -> 0,0.9,0
bind.move_x=key:a/-1,key:d/+1,key:left/-1,key:right/+1,gamepad:leftx
bind.lift=key:space,gamepad:south
# Save games: quicksave / quickload are reserved actions (these are also the defaults).
bind.quicksave=key:f5
bind.quickload=key:f9
# Sample gameplay: B blasts the tower apart; 1 / 2 save / load slot "slot1" from Lua.
bind.blast=key:b
bind.save_slot1=key:1
bind.load_slot1=key:2
